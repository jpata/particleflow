rule tfds_task:
    input:
        "snakemake_jobs/idea/post/post_{sample}_all.done"
    params:
        workspace='/local/joosep/mlpf/idea/v1.4.0/50k', versions={'ttbar': '0.5.0', 'ww_fullhad': '0.5.0', 'qq': '0.5.0', 'z_qq': '0.5.0', 'z_tautau': '0.5.0'}
    output:
        "snakemake_jobs/idea/tfds/tfds_{sample}_tfds_{config}.done"
    resources:
        tmpdir="/scratch/local/joosep/tmp", mem_mb=8000, slurm_partition="main", runtime=2880, slurm_account="hepusers", cpus_per_task=1, threads=1
    container:
        "/scratch/persistent/joosep/singularity/particleflow-29042026-de861d.sif"
    shell:
        "snakemake_jobs/idea/tfds/tfds_{wildcards.sample}.sh {wildcards.config} && touch {output}"

rule tfds:
    input:
        expand('snakemake_jobs/idea/tfds/tfds_ttbar_tfds_{config}.done', config=[1]), expand('snakemake_jobs/idea/tfds/tfds_ww_fullhad_tfds_{config}.done', config=[1]), expand('snakemake_jobs/idea/tfds/tfds_qq_tfds_{config}.done', config=[1]), expand('snakemake_jobs/idea/tfds/tfds_z_qq_tfds_{config}.done', config=[1]), expand('snakemake_jobs/idea/tfds/tfds_z_tautau_tfds_{config}.done', config=[1])
    output:
        "snakemake_jobs/idea/tfds/all.done"
    shell:
        "touch {output}"

rule train_pyg_idea_pipeline_v1:
    input:
        "snakemake_jobs/idea/tfds/all.done"
    output:
        "snakemake_jobs/idea/train/train_pyg-idea-pipeline-v1_idea.done"
    threads: 16
    resources:
        tmpdir="/scratch/local/joosep/tmp", mem_mb=40000, slurm_partition="gpu", runtime=10080, slurm_account="hepusers", gres="gpu:l40:1", cpus_per_task=16, threads=16
    container:
        "/scratch/persistent/joosep/singularity/particleflow-29042026-de861d.sif"
    shell:
        "snakemake_jobs/idea/train/train_pyg-idea-pipeline-v1_idea.sh && touch {output}"
